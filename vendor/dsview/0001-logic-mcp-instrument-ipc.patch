+#ifndef DSVIEW_PV_LOGICMCPIPC_H
+#define DSVIEW_PV_LOGICMCPIPC_H
+
+#include <QObject>
+#include <QByteArray>
+#include <QJsonObject>
+#include <QString>
+
+class QLocalServer;
+class QLocalSocket;
+
+namespace pv {
+
+class SigSession;
+class MainWindow;
+
+namespace toolbars {
+class SamplingBar;
+}
+
+class LogicMcpIpc : public QObject
+{
+    Q_OBJECT
+
+public:
+    LogicMcpIpc(MainWindow *window, SigSession *session, toolbars::SamplingBar *bar);
+    ~LogicMcpIpc();
+
+    bool startServer();
+
+private slots:
+    void onNewConnection();
+    void onReadyRead();
+    void onDisconnected();
+
+private:
+    QString socketPath() const;
+    void drainRequests();
+    QJsonObject handle(const QJsonObject &req);
+    QJsonObject helloResult() const;
+    QJsonObject statusResult() const;
+    QJsonObject capabilitiesResult() const;
+    QJsonObject startCapture();
+    QJsonObject stopCapture();
+    QJsonObject waitCapture(double timeout_s);
+    QJsonObject exportCapture(const QJsonObject &params);
+    QString hubState() const;
+    bool hasLogicData() const;
+    void pumpEvents(int ms);
+    static QJsonObject errorObject(int id, const QString &code, const QString &message);
+    static QJsonObject resultObject(int id, const QJsonObject &result);
+    void writeJson(QLocalSocket *sock, const QJsonObject &obj);
+
+    SigSession *_session;
+    toolbars::SamplingBar *_sampling_bar;
+    QLocalServer *_server;
+    QLocalSocket *_client;
+    QByteArray _buf;
+    bool _handling;
+    bool _started_ok;
+    bool _capture_finished;
+};
+
+} // namespace pv
+
+#endif
